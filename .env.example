# Opcional. La web ya usa esta direccion por defecto.
# Tanto la URL base como la URL terminada en /v1 son validas.
LM_STUDIO_BASE_URL=http://172.23.32.1:1234/v1

# Vacio: se selecciona automaticamente el primer modelo de chat disponible.
LM_STUDIO_MODEL=

# Respuestas directas para el gemelo. Usa default para respetar el ajuste del modelo.
LM_STUDIO_REASONING_EFFORT=none

# Opcional: solo si activas autenticacion en LM Studio.
# Las claves son exclusivas del servidor. No uses el prefijo NEXT_PUBLIC_.
LM_STUDIO_API_KEY=

# Opcional: dominio de la web para los metadatos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
